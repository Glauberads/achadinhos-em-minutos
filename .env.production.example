# BUILD-TIME PUBLIC — embedded in the Web bundle
VITE_SUPABASE_URL=https://replace-with-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_public_anon_key

# RUNTIME SERVER — required
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_secret
ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
CORS_ORIGINS=https://app.achadinhos.builderfy.com.br
LOG_LEVEL=info

# RUNTIME SERVER — fixed by Compose in production
NODE_ENV=production
PORT=3001
REDIS_URL=redis://redis:6379

# CAPABILITY SECRETS — configure only when the capability is enabled
GEMINI_API_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# CAPABILITY SETTINGS
ASAAS_MODE=production
AI_PROVIDER=gemini
CREATIVE_AI_PROVIDER=gemini
CREATIVE_AI_MOCK_ENABLED=false
WORKER_CONCURRENCY=1
TELEGRAM_SEND_INTERVAL_SECONDS=30
