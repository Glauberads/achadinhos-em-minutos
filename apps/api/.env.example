# ==========================================
# ACHADINHOS EM MINUTOS — API ENV
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ============================
# CORE
# ============================
NODE_ENV="development"           # development | production
PORT=3001
LOG_LEVEL="info"                 # debug | info | warn | error | fatal

# ============================
# CORS & SECURITY
# ============================
# Allowed origins (comma-separated). In production, set to your real domain.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# Encryption key for crypto module (must be exactly 32 random bytes, base64 encoded)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ============================
# SUPABASE (Postgres + Auth)
# ============================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# ⚠️ This key bypasses RLS. Never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# ============================
# REDIS (Cache + BullMQ Queues)
# ============================
REDIS_URL="redis://localhost:6379"
# Alternative: REDIS_HOST + REDIS_PORT (used if REDIS_URL is not set)
# REDIS_HOST="localhost"
# REDIS_PORT=6379

# ============================
# AI (Gemini)
# ============================
GEMINI_API_KEY=""
# AI_PROVIDER="gemini"          # gemini (default) — extensible
# CREATIVE_AI_MOCK_ENABLED="false"
# CREATIVE_AI_PROVIDER="gemini"

# ============================
# ASAAS (Payment Gateway)
# ============================
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_MODE="mock"               # mock | sandbox | production

# ============================
# TELEGRAM
# ============================
# BOT_TOKEN=""                  # Used by telegram workers
# TELEGRAM_SEND_INTERVAL_SECONDS=30

# ============================
# WORKERS
# ============================
# WORKER_CONCURRENCY=1

# ============================
# DEBUG (Optional)
# ============================
# DEBUG_PRODUCT_IMAGE_EXTRACTION="false"
