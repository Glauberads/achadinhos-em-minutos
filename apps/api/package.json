{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:workers": "tsx watch src/workers/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:api": "node dist/server.js",
    "start:creative-worker": "node dist/workers/creative.worker.js",
    "start:ffmpeg-worker": "node dist/workers/ffmpeg.worker.js",
    "start:campaign-worker": "node dist/workers/campaign.worker.js",
    "start:telegram-worker": "node dist/workers/telegram.worker.js"
  },
  "dependencies": {
    "@achadinhos/shared": "workspace:*",
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@supabase/supabase-js": "^2.43.0",
    "bullmq": "^5.7.8",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
