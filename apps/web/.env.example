# ==========================================
# ACHADINHOS EM MINUTOS — FRONTEND ENV
# ==========================================
# Variables prefixed with VITE_ are embedded in the browser bundle.
# NEVER put secrets (API keys, service_role, passwords) here.

# Supabase (public anon key only — safe for browser)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_publica_anon"

# API URL — leave empty to use relative /api (reverse proxy)
# Set to full URL only for development without proxy
VITE_API_URL=""
