{
  "name": "achadinhos-em-minutos",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS para automação de posts de afiliados",
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:api": "pnpm --filter api run dev:api",
    "dev:workers": "pnpm --filter api run dev:workers",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
